// BZFlag Windows resource script (mingw windres compatible).
// Original: MSVC/bzflag.rc, removed in eddec0fa2; restored 2026-09-27
// for the msys2/mingw64 build so executables carry icon + version info.

#include <winver.h>

1 ICON "bzflag.ico"

1 VERSIONINFO
FILEVERSION 2,4,31,0
PRODUCTVERSION 2,4,31,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName",      "BZFlag"
      VALUE "FileDescription",  "BZFlag client"
      VALUE "FileVersion",      "2.4.31"
      VALUE "InternalName",     "bzflag"
      VALUE "OriginalFilename", "bzflag.exe"
      VALUE "ProductName",      "BZFlag"
      VALUE "ProductVersion",   "2.4.31"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END